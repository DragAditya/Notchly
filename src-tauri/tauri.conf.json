{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notchly",
  "version": "../package.json",
  "identifier": "com.dragaditya.notchly",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist",
	"removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "Notchly",
        "width": 820,
        "height": 480,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCNDZGODZENEMwQzU5RjIKUldUeVdReE1iZmhHaXl2MmR5RUlka1ZQY0xERmNZbGRuRnlsVE5hR0VJWWY4MjBUeXJ4MUc0QjgK",
      "endpoints": [
        "https://github.com/DragAditya/Notchly/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
